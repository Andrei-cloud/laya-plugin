__pycache__/
*.pyc
*.err
*.out
exps.err
http.out
diag_latency*.py
probe_*.py
# machine-local convenience symlink (-> a local model assets dir); the tree
# resolves assets via $LAYA_ASSETS with sane defaults, never a tracked path
assets
logs/
runs_warm.log

# benchmark working material: outputs are never tracked; the harness code
# (bench/*.py) IS part of the solution and is tracked.
bench/*
!bench/*.py
!bench/README.md
!bench/tasks.json
# authored eval packs are fixtures (gold-labeled, train-excluded by design),
# like tasks.json — tracked; runs/ stays untracked
!bench/evalpacks/
!bench/evalpacks/*.jsonl
# one-off sweep-resume helper (session-scoped, not part of the rig)
bench/_continue_sweep.py

# local scratch / IDE
.DS_Store
.pytest_cache/

# run outputs from acceptance/sandbox drills
bench/sandbox*/
bench/runs/
bench/audit-arm*.jsonl
